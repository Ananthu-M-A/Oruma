{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/therapist-profile.mjs": {
      "includeFiles": "dist/index.html",
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/login",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/register",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/profile/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600" }]
    }
  ],
  "rewrites": [
    {
      "source": "/therapists/:id",
      "destination": "/api/therapist-profile?id=:id"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
