VITE_API_URL=http://localhost:3000
# Vercel server-rendered practitioner profile shell (use the public API origin).
ORUMA_API_URL=http://localhost:3000
ORUMA_SITE_URL=http://localhost:5173
# Google Analytics 4 measurement ID (for example, G-XXXXXXXXXX).
VITE_GA_MEASUREMENT_ID=
# Search Console HTML-tag verification content. DNS verification does not need this.
VITE_GOOGLE_SITE_VERIFICATION=
# Development only: pair with PAYMENT_BYPASS_ENABLED=true on the server.
VITE_PAYMENT_BYPASS_ENABLED=false
# Development only: pair with BOOKING_LEAD_TIME_BYPASS_ENABLED=true on the server.
VITE_BOOKING_LEAD_TIME_BYPASS_ENABLED=false
