PORT=3000
NODE_ENV=development
# Development only: allows authenticated patients to simulate paid bookings.
PAYMENT_BYPASS_ENABLED=false
UNPAID_RESERVATION_TTL_MINUTES=15
RESERVATION_CLEANUP_ENABLED=true
# Extra time for gateway/webhook reconciliation before a pending-order slot is released.
PAYMENT_RECONCILIATION_GRACE_MINUTES=15
PROVIDER_WORKER_ENABLED=true
PROVIDER_WORKER_BATCH_SIZE=10
PRIVACY_AUTO_ERASURE_ENABLED=false
ACCOUNT_ERASURE_GRACE_DAYS=7
CLINICAL_RECORD_RETENTION_DAYS=2555
# Enable only after the operator approves these retention periods.
DATA_RETENTION_WORKER_ENABLED=false
AUDIT_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=180
OTP_RETENTION_DAYS=7
PROVIDER_JOB_RETENTION_DAYS=90
PAYMENT_WEBHOOK_RETENTION_DAYS=365
PRIVACY_REQUEST_RETENTION_DAYS=2555
# Development only: allows near-term slots to be listed and booked without the 24-hour wait.
BOOKING_LEAD_TIME_BYPASS_ENABLED=false
CLIENT_ORIGIN=http://localhost:5173
CLIENT_LOGIN_URL=http://localhost:5173/login

# Remote PostgreSQL connection string (recommended for Neon, Supabase, Railway, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

DATABASE_URL=
DATABASE_SYNC=false
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_PORT=5432

JWT_SECRET=change_me
JWT_EXPIRES_IN=1h
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=256kb
GLOBAL_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_15_MINUTES=30

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=ORUMA Admin
ADMIN_PHONE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
EMAIL_FROM="Oruma <notifications@updates.oruma.me>"

# Use matching Live Mode keys in production. In Razorpay Dashboard, confirm
# UPI is Activated and that UPI Intent plus Dynamic QR are available before launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

ALLOW_PRODUCTION_DATABASE_CLEAR=false
